<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zoekt-for-agents.reindex</string>
  <key>ProgramArguments</key>
  <array><string>@HOME@/.zoekt/reindex.sh</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/.zoekt/launchd.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.zoekt/launchd.log</string>
</dict>
</plist>
