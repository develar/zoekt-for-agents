{
  "permissions": {
    "allow": ["Bash(zk:*)", "Bash(zkf:*)", "Bash(zk-wt:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I @PROJECT@/hooks/claude/no-repo-wide-grep.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
